# Copy this file to .env and fill in real values.

# MongoDB connection string, e.g. mongodb://localhost:27017
MONGO_URL=

# Database name to use on the MongoDB instance above
DB_NAME=

# Comma-separated list of origins allowed to make credentialed requests,
# e.g. https://example.com,https://app.example.com
# Leave empty to allow no cross-origin requests.
CORS_ORIGINS=
